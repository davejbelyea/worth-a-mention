# ---- Required ----
# The public web address of the site (no trailing slash)
APP_URL=http://localhost:3000
# The founder's email. This person is always the administrator.
ADMIN_EMAIL=you@example.com
# Where the database and uploaded photos live. Use a persistent disk in production.
DATA_DIR=./data

# ---- Google sign-in (optional but recommended) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (magic links, invitations, Thursday newsletter) ----
# Get a key at resend.com. Without it, emails are printed to the server log instead.
RESEND_API_KEY=
EMAIL_FROM="Worth a Mention <hello@yourdomain.com>"

# ---- Scheduled newsletter ----
# The app checks every few minutes on its own. If your host prefers an external
# cron, call GET /api/cron/digest with header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me-too
